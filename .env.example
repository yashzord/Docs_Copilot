# Copy to .env (gitignored). Every value here is a placeholder, never a secret.

# Named profile from `aws configure --profile docs-copilot-dev`. Scoped to Bedrock invoke only.
AWS_PROFILE=docs-copilot-dev
# Locked to us-west-2: Bedrock Rerank API and AgentCore are available here.
AWS_REGION=us-west-2

# The chat model. Cross-region inference profile ID (starts with "global." or "us.").
# Copy the exact string from Bedrock console, Inference profiles. Do not type from memory.
# Why this model: see docs/learning/ai.md section 2. A router model is added in D3.
BEDROCK_SYNTH_MODEL_ID=

# frontend reaches the API here. Inside docker compose it becomes http://api:8000.
API_URL=http://localhost:8000
