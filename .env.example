# Copy to .env (gitignored). Every value here is a placeholder, never a secret.

# Named profile from `aws configure --profile docs-copilot-dev`. Scoped to Bedrock invoke only.
AWS_PROFILE=docs-copilot-dev
# Locked to us-west-2: Bedrock Rerank API and AgentCore are available here.
AWS_REGION=us-west-2

# Cross-region inference profile IDs (they start with "us."). Copy the exact strings
# from the Bedrock console model catalog. Do not type them from memory.
BEDROCK_ROUTER_MODEL_ID=
BEDROCK_SYNTH_MODEL_ID=

# apps/web reaches the API here. Inside docker compose it becomes http://api:8000.
API_URL=http://localhost:8000
