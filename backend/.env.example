# Copy to backend/.env (gitignored). Placeholders only, never secrets.
# app/settings.py reads this file when the server runs from backend/.

# Named profile from `aws configure --profile docs-copilot-dev`. Scoped to Bedrock only.
AWS_PROFILE=docs-copilot-dev
# Locked to us-west-2: Bedrock Rerank API and AgentCore are available here.
AWS_REGION=us-west-2

# The chat model. Cross-region inference profile ID (starts with "global." or "us.").
# Copy the exact string from Bedrock console, Inference profiles. Do not type from memory.
# Why this model: docs/learning/ai.md section 2. A router model is added in D3.
BEDROCK_SYNTH_MODEL_ID=
