# Copy to backend/.env (gitignored). IDs only, never secrets.
# app/settings.py reads this file when the server runs from backend/.
# Every key here must exist in app/settings.py, or the app refuses to start.

# Named profile from `aws configure --profile docs-copilot-dev`.
AWS_PROFILE=docs-copilot-dev
# Locked to us-west-2: AgentCore and the Bedrock rerank model are available here.
AWS_REGION=us-west-2

# ---- documents (docs/learning/aws.md sections 6 and 7) ----
# The bucket uploads go to. Files land under tenants/<tenant_id>/.
S3_BUCKET=docs-copilot-901708383582
# The managed Knowledge Base and its S3 data source (AgentCore console, Knowledge Bases).
KB_ID=0JTWTJABTV
KB_DATA_SOURCE_ID=PRRFGHTJBS

# ---- the agent (docs/learning/aws.md section 10) ----
# The harness (AgentCore console, Harness). The API calls it with InvokeHarness.
# Its model, prompt and tools (the gateway) are set on the harness, not here.
HARNESS_ARN=arn:aws:bedrock-agentcore:us-west-2:901708383582:harness/docs_copilot_assistant-bwVinula0L
# The harness's managed memory (harness detail page, Memory). Read for the chat sidebar.
MEMORY_ID=docs_copilot_assistant-6aIbceHbw1
