# Copy to frontend/.env.local (gitignored). Read only on the server, never sent to the browser.
# Where the FastAPI backend listens. Use the port you started uvicorn on.
API_URL=http://localhost:8001

# Login (docs/course/, lesson 31). NEXT_PUBLIC_ means the browser gets these; they are
# public identifiers, not secrets. Cognito console: the user pool's domain (Branding,
# Domain) and the app client id (App clients).
NEXT_PUBLIC_COGNITO_DOMAIN=https://<your-prefix>.auth.us-west-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=<app client id>
